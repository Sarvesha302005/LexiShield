# ==============================================================================
# PayPal Dispute Resolution Engine - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production, test)
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
HOST=0.0.0.0
PORT=8000

# PayPal REST API Configuration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=mock_paypal_client_id_12345
PAYPAL_CLIENT_SECRET=mock_paypal_client_secret_67890
PAYPAL_WEBHOOK_ID=mock_paypal_webhook_id_abcde
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# Webhook Verification Settings
# In production, set to true to enforce strict PayPal X.509 signature validation.
# In development/test, can be set to false for local simulation without real PayPal certs.
STRICT_WEBHOOK_VERIFICATION=true

# OpenRouter / Multi-Model 3-Tier LLM Orchestration Layer
OPENROUTER_API_KEY=mock_openrouter_api_key_replace_with_actual
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_TIMEOUT_SECONDS=25.0

# Legacy Google Gemini Settings (optional fallback alias)
GEMINI_API_KEY=mock_gemini_api_key_replace_with_actual
GEMINI_MODEL=google/gemini-2.0-flash-thinking-exp:free

# Financial Arbitration & Fee Parameters
STANDARD_DISPUTE_FEE=15.00
HIGH_VOLUME_DISPUTE_FEE=30.00
HIGH_DISPUTE_FEE_THRESHOLD_MONTHLY_DISPUTES=100
HIGH_RISK_TENANT_ANOMALY_THRESHOLD=0.015

# Decision Engine Thresholds & Universal Defense Policy
SELLER_RIGHTS_FIRST_ENABLED=true
DEFEND_P_WIN_THRESHOLD=0.70
HITL_ORDER_VALUE_THRESHOLD=300.00
HITL_P_WIN_LOWER=0.60
HITL_P_WIN_UPPER=0.75
