    {
      "name": "4. Pre-Chargeback Alert Deflection",
      "item": [
        {
          "name": "Ingest Ethoca / Verifi Alert (Zero-Fee Refund)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alert_id\": \"ALT-POSTMAN-9901\",\n  \"network\": \"ETHOCA\",\n  \"order_id\": \"ORD-DEFLECT-7720\",\n  \"amount\": 142.50,\n  \"currency\": \"USD\",\n  \"reason_code\": \"10.4\",\n  \"reason_description\": \"Cardholder fraud notification prior to chargeback posting\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/alerts/deflection",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "alerts", "deflection"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Deflection triggered and fee avoided\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.include(\"REFUNDED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
