              "path": ["api", "v1", "disputes", "hitl", "queue"]
            }
          }
        },
        {
          "name": "Execute HITL Review Override",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewer_id\": \"OP-LEAD-POSTMAN-JUDGE\",\n  \"action\": \"DEFEND\",\n  \"override_reason\": \"Carrier GPS and warehouse anti-tamper imagery confirmed by operator sign-off\"\n}"
